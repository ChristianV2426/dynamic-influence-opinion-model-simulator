{
  "mode": "custom",
  "iterationLimit": 10,
  "recordInfluenceHistory": true,
  "distributionFunction": {"type": "gaussian", "c": 10},
  "agents": [
    {"name": "Agent1", "opinion": 1.0, "dynamicInfluence": true},
